<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse</groupId>
        <artifactId>quarkiverse-parent</artifactId>
        <version>26</version>
    </parent>

    <groupId>io.quarkiverse.nativematrix</groupId>
    <artifactId>quarkus-native-matrix-parent</artifactId>
    <version>999-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Quarkus Native Matrix - Parent</name>

    <modules>
        <module>spi</module>
        <module>runtime</module>
        <module>deployment</module>
    </modules>

    <scm>
        <connection>scm:git:git@github.com:quarkiverse/quarkus-native-matrix.git</connection>
        <developerConnection>scm:git:git@github.com:quarkiverse/quarkus-native-matrix.git</developerConnection>
        <url>https://github.com/quarkiverse/quarkus-native-matrix</url>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.version>3.40.1</quarkus.version>
        <sshd.version>2.20.0</sshd.version>
        <assertj.version>3.27.7</assertj.version>
        <bouncycastle-lts.version>2.73.13</bouncycastle-lts.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.nativematrix</groupId>
                <artifactId>quarkus-native-matrix-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.nativematrix</groupId>
                <artifactId>quarkus-native-matrix</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-core</artifactId>
                <version>${sshd.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-sftp</artifactId>
                <version>${sshd.version}</version>
            </dependency>
            <dependency>
                <groupId>net.jsign</groupId>
                <artifactId>jsign-core</artifactId>
                <version>7.6</version>
            </dependency>
            <!-- the Quarkus BOM manages bcutil-lts8on only: align the BouncyCastle LTS jars with the version Jsign uses -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-lts8on</artifactId>
                <version>${bouncycastle-lts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-lts8on</artifactId>
                <version>${bouncycastle-lts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-lts8on</artifactId>
                <version>${bouncycastle-lts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpg-lts8on</artifactId>
                <version>${bouncycastle-lts.version}</version>
            </dependency>
            <dependency>
                <groupId>net.i2p.crypto</groupId>
                <artifactId>eddsa</artifactId>
                <version>0.3.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <!-- not released: the documentation is published from the repository by docs.quarkiverse.io.
                 Needs JDK 21+: quarkus-config-doc-maven-plugin is compiled for Java 21 (the extension supports 17). -->
            <id>unreleased-modules</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>!true</value>
                </property>
                <jdk>[21,)</jdk>
            </activation>
            <modules>
                <module>docs</module>
            </modules>
        </profile>
        <profile>
            <!-- real native builds: mvn -Pit package -Dnative-matrix (see the README) -->
            <id>it</id>
            <modules>
                <module>integration-tests/sample-app</module>
            </modules>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-extension-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
