<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.quarkiverse.nativematrix</groupId>
        <artifactId>quarkus-native-matrix-parent</artifactId>
        <version>999-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>quarkus-native-matrix-sample-app</artifactId>
    <name>Quarkus Native Matrix - Sample application</name>
    <description>A command line application used to validate real native matrix builds end to end</description>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.nativematrix</groupId>
            <artifactId>quarkus-native-matrix</artifactId>
        </dependency>
        <!-- make sure the extension is built before this module with mvn -am -->
        <dependency>
            <groupId>io.quarkiverse.nativematrix</groupId>
            <artifactId>quarkus-native-matrix-deployment</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <!-- end-to-end check of the SNAPSHOT shipping of full mode: install a greeting-lib 1.0-SNAPSHOT locally first -->
            <id>e2e-snapshot</id>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.nativematrix.it</groupId>
                    <artifactId>greeting-lib</artifactId>
                    <version>1.0-SNAPSHOT</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
